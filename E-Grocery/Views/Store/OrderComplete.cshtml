@{
    ViewData["Title"] = "Order Complete";
}

<div class="min-h-[calc(100vh-120px)] bg-gray-50 px-4 py-8 flex items-center justify-center">
    <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-8 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-9 w-9 text-[#2e7d32]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-800 mb-2">Order Complete!</h2>
        <p class="text-gray-500 mb-8">Your order is on the way.</p>
        <a asp-action="Index" class="inline-block w-full bg-[#2e7d32] text-white font-semibold py-2.5 rounded-lg hover:bg-[#1b5e20] transition duration-200 shadow-md">
            Continue Shopping
        </a>
    </div>
</div>
