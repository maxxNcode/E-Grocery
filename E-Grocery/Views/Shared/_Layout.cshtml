<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>@ViewData["Title"] - E-Grocery ni Aling Bebang</title>
    <script type="importmap"></script>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <script src="https://cdn.tailwindcss.com"></script>
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    @* <link rel="stylesheet" href="~/E_Grocery.styles.css" asp-append-version="true" /> *@
    <style>
        *{
            padding: 0;
            margin: 0;
        }
    </style>
</head>
<body>
    <header class="bg-[#2e7d32] flex px-6 py-3 justify-between items-center">
        <a asp-controller="Store" asp-action="Index" class="logo flex gap-2 items-center hover:opacity-90 transition">
            <img src="/logo.svg" alt="E-Grocery Logo" class="h-10 w-10" />
            <div class="text-logo text-xl font-bold text-white tracking-wide">E-GROCERY NI BEBANG</div>
        </a>

        @{
            var title = "";
            if (ViewData["Title"] != null)
            {
                title = ViewData["Title"].ToString();
            }

            var hideNav = false;
            if (title == "Login" || title == "Register" || title == "Cart")
            {
                hideNav = true;
            }
            if (ViewData["HideNav"] != null && (bool)ViewData["HideNav"])
            {
                hideNav = true;
            }
        }
        @if (!hideNav)
        {
            <form asp-controller="Store" asp-action="Search" method="get" class="search-bar flex items-center bg-white rounded-lg overflow-hidden w-full max-w-md mx-6">
                <input type="text" name="searchTerm" placeholder="Search products..." value="@ViewBag.SearchTerm" class="w-full px-4 py-2 text-sm text-gray-700 focus:outline-none" />
                <button type="submit" class="bg-[#1b5e20] text-white px-4 py-2 text-sm hover:bg-[#0d3b12] transition">
                    Search
                </button>
            </form>
        }

        <div class="right-contents flex items-center gap-4">
            <a asp-controller="Store" asp-action="Cart" class="cart-icon text-white hover:text-gray-200 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                </svg>
            </a>
            @{
                var userEmail = Context.Session.GetString("UserEmail");
                if (userEmail != null && userEmail != "")
                {
                    <a asp-controller="Account" asp-action="Profile" class="hidden sm:block text-white hover:text-gray-200 text-sm font-medium transition">
                        My Account
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="hidden sm:block text-white hover:text-gray-200 text-sm font-medium transition">
                        Logout
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="hidden sm:block text-white hover:text-gray-200 text-sm font-medium transition">
                        Login
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="hidden sm:block text-white hover:text-gray-200 text-sm font-medium transition">
                        Register
                    </a>
                }
            }
        </div>
    </header>
    <div class="w-full">
        <main role="main" class="w-full">
            @RenderBody()
        </main>
    </div>

    <footer class="flex items-center justify-center">
        &copy; 2026 - E-Grocery ni Aling Bebang
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
