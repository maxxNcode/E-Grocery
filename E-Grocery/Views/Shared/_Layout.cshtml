<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E_Grocery</title>
    <script type="importmap"></script>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <script src="https://cdn.tailwindcss.com"></script>
    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    @* <link rel="stylesheet" href="~/E_Grocery.styles.css" asp-append-version="true" /> *@
    <style>
        *{
            padding: 0;
            margin: 0;
        }
    </style>
</head>
<body>
    <header class="bg-[#2e7d32] flex px-6 py-3 justify-between items-center">
        <div class="logo flex gap-2 items-center">
            <div class="image-logo h-10 w-10 bg-white rounded-md"></div>
            <div class="text-logo text-xl font-bold text-white tracking-wide">E-GROCERY NI BEBANG</div>
        </div>

        <div class="search-bar flex items-center bg-white rounded-lg overflow-hidden w-full max-w-md mx-6">
            <input type="text" id="Search" placeholder="Search products..." class="w-full px-4 py-2 text-sm text-gray-700 focus:outline-none">
            <button class="bg-[#1b5e20] text-white px-4 py-2 text-sm hover:bg-[#0d3b12] transition">
                Search
            </button>
        </div>

        <div class="right-contents flex items-center gap-4">
            <div class="cart-icon text-white hover:text-gray-200 transition cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                </svg>
            </div>
            <div class="profile-icon text-white hover:text-gray-200 transition cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <button class="bg-white text-[#2e7d32] font-semibold py-2 px-4 rounded-lg text-sm hover:bg-gray-100 transition">
                Login
            </button>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - E_Grocery - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
