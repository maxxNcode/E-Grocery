@model E_Grocery.Models.User

@{
    ViewData["Title"] = "My Account";
}

<div class="min-h-[calc(100vh-120px)] bg-gray-50 px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">My Account</h1>

        <div class="bg-white rounded-2xl shadow-lg p-8">
            <div class="text-center mb-8">
                <div class="inline-block relative">
                    @if (Model.ProfilePicture != null && Model.ProfilePicture != "")
                    {
                        <img src="@Model.ProfilePicture" alt="Profile" class="h-24 w-24 rounded-full object-cover border-4 border-[#2e7d32]" />
                    }
                    else
                    {
                        <div class="h-24 w-24 rounded-full bg-gray-200 flex items-center justify-center border-4 border-[#2e7d32]">
                            <span class="text-3xl font-bold text-gray-400">@Model.FullName[0]</span>
                        </div>
                    }
                </div>
                <h2 class="text-xl font-bold text-gray-800 mt-4">@Model.FullName</h2>
                <p class="text-gray-500">@Model.Email</p>
            </div>

            <form asp-action="Profile" method="post" enctype="multipart/form-data" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                    <input asp-for="FullName" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2e7d32] focus:border-transparent transition" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input asp-for="Email" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg bg-gray-100 text-gray-500 cursor-not-allowed" readonly />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Profile Picture</label>
                    <input type="file" name="profilePicture" accept="image/*" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2e7d32] focus:border-transparent transition" />
                    <p class="text-xs text-gray-400 mt-1">Upload a new profile picture (optional)</p>
                </div>

                <button type="submit" class="w-full bg-[#2e7d32] text-white font-semibold py-2.5 rounded-lg hover:bg-[#1b5e20] transition duration-200 shadow-md">
                    Update Profile
                </button>
            </form>

            <div class="mt-6 pt-6 border-t border-gray-100">
                <a asp-controller="Store" asp-action="OrderHistory" class="flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition">
                    <div class="flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#2e7d32]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        <span class="font-medium text-gray-700">Order History</span>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</div>
